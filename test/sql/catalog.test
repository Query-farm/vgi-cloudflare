# Catalog + error-path smoke tests for the Cloudflare VGI worker.
# These need NO Cloudflare token — they exercise ATTACH, schema visibility via
# bind (DESCRIBE), and the missing-argument / missing-secret error paths.

require-env VGI_CLOUDFLARE_WORKER

require vgi

statement ok
ATTACH 'cloudflare' AS cf (TYPE vgi, LOCATION '${VGI_CLOUDFLARE_WORKER}');

# zones table schema is available without a secret (bind needs no credentials).
query I
SELECT count(*) FROM (DESCRIBE cf.zones.zones);
----
12

# dns.records is a function of the zone id, and returns it as a column.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM cf.dns.records('some-zone')) WHERE column_name = 'zone_id';
----
1

# Calling dns.records without its zone id must fail (it is a required argument).
statement error
SELECT * FROM cf.dns.records();
----

# Querying zones without a cloudflare secret must fail clearly.
statement error
SELECT * FROM cf.zones.zones;
----

# A scoped list function is present and exposes its schema via bind.
query I
SELECT count(*) > 0 FROM (DESCRIBE SELECT * FROM cf.accounts.members('some-account')) WHERE column_name = 'account_id';
----
true

# A scoped list function errors without its required id argument.
statement error
SELECT * FROM cf.accounts.members();
----

# GraphQL analytics are functions of the zone id with a required window.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM cf.analytics.http_requests_daily('z', since := DATE '2024-01-01', until := DATE '2024-01-02')) WHERE column_name = 'zone_id';
----
1

# The window is required: no silent default that could truncate results.
statement error
SELECT * FROM cf.analytics.http_requests_daily('z');
----

# Additional GraphQL datasets are present with their dimensions/metrics.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM cf.analytics.firewall_events('z', since := TIMESTAMPTZ '2024-01-01 00:00:00+00', until := TIMESTAMPTZ '2024-01-01 01:00:00+00'))
WHERE column_name IN ('datetime', 'action', 'count');
----
3

statement error
SELECT * FROM cf.analytics.firewall_events();
----

# Account-scoped dataset requires account_id.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM cf.analytics.workers_invocations('a', since := TIMESTAMPTZ '2024-01-01 00:00:00+00', until := TIMESTAMPTZ '2024-01-01 01:00:00+00')) WHERE column_name = 'account_id';
----
1

# Get-by-id "item" functions are callable as table functions with arguments.
# Without a secret they error cleanly (proves bind + arg parsing happen first).
statement error
SELECT * FROM cf.zones.zone('some-zone-id');
----

statement error
SELECT * FROM cf.accounts.user();
----

# Wrong arity is a binder error — the path params are part of the signature.
statement error
SELECT * FROM cf.dns.record('only-one-arg');
----
